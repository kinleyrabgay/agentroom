{
  "name": "@kinleyrabgay/agentroom",
  "version": "0.0.1",
  "description": "Local control room for AI coding agents: run a team of Claude bots in any repo, watch every tool call live, and approve risky actions.",
  "type": "module",
  "keywords": [
    "ai",
    "agents",
    "coding-agent",
    "claude",
    "claude-agent-sdk",
    "multi-agent",
    "developer-tools",
    "cli",
    "code-review",
    "automation"
  ],
  "homepage": "https://github.com/kinleyrabgay/agentroom#readme",
  "bugs": {
    "url": "https://github.com/kinleyrabgay/agentroom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinleyrabgay/agentroom.git"
  },
  "author": "Kinley Rabgay",
  "bin": {
    "agentroom": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:cli",
    "build:cli": "tsup",
    "build:web": "npm --prefix web run build && rm -rf dist/ui && mkdir -p dist && cp -R web/out dist/ui",
    "dev:web": "NEXT_PUBLIC_AGENTROOM_API=http://127.0.0.1:4317 npm --prefix web run dev",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "test": "vitest run",
    "lint": "npm --prefix web run lint",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.13",
    "open": "^11.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "publishConfig": {
    "access": "public"
  }
}
